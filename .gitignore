# Secrets — never commit. See docs/SECRETS.md
.env
.env.*
!example-vars

# Dependencies
node_modules/

# Build / runtime
dist/
*.log
.DS_Store

# Recorded audio fixtures may contain real voices — keep local unless cleared
fixtures/audio/*.webm
fixtures/audio/*.mp4
fixtures/audio/*.m4a
fixtures/audio/*.wav
fixtures/audio/*.ogg

# Local workspace — tactical docs, handoffs, scratch notes (not part of the repo)
.scratch/

# Multi-agent consensus runs — local decision logs, not part of the repo
.consensus-runs/

# Claude Code — personal/local settings stay local; shared agents + skills are committed
.claude/settings.local.json

# Asset bundles — distributed via GitHub Releases, never committed
scenario-assets-*.tgz

# Local generated-asset library (audio + images) — reusable content, kept local for now.
# May later be promoted to a shippable/synced library; gitignored during build-up.
# Root-anchored so it does NOT match the source dir server/assets/.
/assets/
