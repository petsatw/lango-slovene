# Copy this file to .env and fill in real values IN A TEXT EDITOR (not the shell).
# See docs/SECRETS.md. Never commit .env.

# --- Which provider fills each swappable role (E2 = understand+tutor, E3 = Slovenian voice,
#     E4 = image generation for scenario story frames / scene images) ---
E2_PROVIDER=gemini
E3_PROVIDER=elevenlabs
E4_PROVIDER=grok

# --- E2: Google Gemini (audio-in understanding + in-character tutoring) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- E3: ElevenLabs (native-quality Slovenian TTS) ---
# NOTE: only eleven_v3 supports Slovenian; multilingual_v2 / flash_v2_5 do not. v3 may be
# higher-latency / access-gated — the e3 probe will confirm access when you add the key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Also voices the `slavko` profile — Slavko is deliberately bound to this same id so he is ONE voice
# across onboarding, rehearsal dialogues, and the live tutor (see server/adapters/elevenlabs.ts).
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_SHOP_ASSISTANT=

# --- E4: xAI Grok image generation (scenario story-frame + scene images) ---
# Endpoint is OpenAI-compatible (https://api.x.ai/v1/images/generations). grok-imagine-image-quality
# is the current recommended model (grok-imagine-image-pro was deprecated 2026-05-15).
GROK_API_KEY=
GROK_IMAGE_MODEL=grok-imagine-image-quality

# --- LIVE TUTOR (continuous speech; "Go live"). Internal testing only — this is the one surface that
#     meters a vendor BY THE MINUTE, so it stays closed until LIVE_ACCESS_CODE is set, and the real
#     ceiling is a provider-side spend cap in the vendor console, not anything in this file. ---
# Unset = the live tutor is closed. Any non-empty value opens it to whoever has the string.
LIVE_ACCESS_CODE=
# Which vendor answers. Testers may override per session (?provider=grok); everyone else gets this.
LIVE_PROVIDER=gemini
SESSION_TTL_SEC=600
LIVE_MAX_CONCURRENT=3

# Gemini Live (native audio, separate model from the E2 turn model above).
GEMINI_MODEL_LIVE=gemini-3.1-flash-live-preview
# Grok Voice. Falls back to GROK_API_KEY (same xAI account as E4) when XAI_API_KEY is unset.
XAI_API_KEY=
XAI_MODEL=grok-voice-think-fast-2.0
XAI_VOICE=eve

# --- Optional alternates for the blind A/B (leave blank until needed) ---
# OPENAI_API_KEY=

# --- Server ---
PORT=8787
